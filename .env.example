# Semblance Canvas Environment Configuration

# Gemini API Key (Optional if configured in config.json or ~/.gemini/settings.json)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Backend: "gemini_cli", "google_genai", or "mock"
AI_BACKEND=gemini_cli

# Path or command for Gemini CLI (defaults to "gemini")
GEMINI_CLI_PATH=gemini

# Allow untrusted folder bypass for automated CLI execution
GEMINI_CLI_TRUST_WORKSPACE=true
